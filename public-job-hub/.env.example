# 복사해 .env로 저장한 뒤 모든 change-* 값을 교체하세요. .env는 Git에서 제외됩니다.
# 운영 서버에서만 보관하고 파일 권한을 관리자 계정으로 제한하세요.
JOBHUB_DOMAIN=jobs.example.com
MYSQL_USERNAME=jobhub
MYSQL_PASSWORD=change-mysql-user-password
MYSQL_ROOT_PASSWORD=change-mysql-root-password
MYSQL_MAX_POOL_SIZE=10
MYSQL_MIN_IDLE=2
# 최초 빈 운영 DB 생성 시 update, 최초 정상 기동 후 validate로 변경
JOBHUB_DDL_AUTO=update

JOBHUB_ADMIN_USERNAME=admin@example.com
JOBHUB_ADMIN_PASSWORD=change-admin-password-at-least-16-characters
JOBHUB_ADMIN_EMAILS=admin@example.com

JOBHUB_PUBLIC_DATA_ENABLED=true
JOBHUB_PUBLIC_DATA_API_KEY=
JOBHUB_CRAWL_SOURCES=JOB-ALIO|https://job.alio.go.kr/recruit.do?order=REG_DATE&pageNo=1|PUBLIC|TABLE|CENTRAL_PUBLIC

OPENAI_API_KEY=
JOBHUB_PAID_AI_ENABLED=false
JOBHUB_OCR_ENABLED=false

# Copy this file to .env on the OCI server. Never commit the real .env file.
JOBHUB_DOMAIN=public-job-hub.duckdns.org
JOBHUB_PUBLIC_URL=https://public-job-hub.duckdns.org

# Copy the JDBC connection information from the TiDB Cloud Connect screen.
MYSQL_URL=jdbc:mysql://<tidb-host>:4000/<database>?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Seoul
MYSQL_USERNAME=<tidb-username>
MYSQL_PASSWORD=<tidb-password>
MYSQL_MAX_POOL_SIZE=4
MYSQL_MIN_IDLE=1
MYSQL_MAX_LIFETIME_MS=300000

# Use validate when the existing TiDB schema is already populated.
JOBHUB_DDL_AUTO=validate

# Only used when the configured account does not already exist in the database.
JOBHUB_ADMIN_USERNAME=admin@public-job-hub.duckdns.org
JOBHUB_ADMIN_PASSWORD=<admin-password-at-least-16-characters>
JOBHUB_ADMIN_EMAILS=admin@public-job-hub.duckdns.org

# Password reset email. Keep mail-enabled=false until the SMTP values have
# been configured and a test message has been received successfully.
JOBHUB_PASSWORD_RESET_MAIL_ENABLED=false
JOBHUB_MAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password-or-app-password>
SMTP_AUTH=true
SMTP_STARTTLS=true

JOBHUB_PUBLIC_DATA_ENABLED=true
JOBHUB_PUBLIC_DATA_API_KEY=<public-data-api-key>
JOBHUB_CRAWL_SOURCES=JOB-ALIO|https://job.alio.go.kr/recruit.do?order=REG_DATE&pageNo=1|PUBLIC|TABLE|CENTRAL_PUBLIC

OPENAI_API_KEY=
JOBHUB_PAID_AI_ENABLED=false
JOBHUB_OCR_ENABLED=false

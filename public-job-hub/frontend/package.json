  },
  "dependencies": {
    "@firebase/app": "^0.14.6",
    "@firebase/messaging": "^0.12.23",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0"
  }
}
